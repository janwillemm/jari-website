<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for p in site.pages %}{% unless p.sitemap == false or p.url == "/sitemap.xml" or p.url contains "/assets/" %}  <url>
    <loc>{{ p.url | absolute_url }}</loc>
  </url>
{% endunless %}{% endfor %}{% for tool in site.tools %}  <url>
    <loc>{{ tool.url | absolute_url }}</loc>
  </url>
{% endfor %}</urlset>
